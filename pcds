#!/usr/bin/env bash
# pcds: install and run a Planet Crafter dedicated server on Linux.
#
#   pcds up [--game DIR] [--world SAVE.json | --new [NEW OPTIONS]] [--steam-user NAME]
#                          everything at once: setup, the service, a selftest, how to join
#   pcds setup [--game DIR] [--world SAVE.json | --new [NEW OPTIONS]] [--steam-user NAME]
#                          build or install the server, extract the game tables from your game
#                          (--steam-user: download the game with steamcmd first), put a world
#                          in place and write the settings and the systemd unit
#   pcds worlds                 the worlds in run/worlds/ (* = the one the server runs)
#   pcds world use NAME | new NAME [NEW OPTIONS] | import SAVE.json [NAME] | remove NAME
#   pcds new [--planet ID] [--start LOCATION] [--seed N] [--set KEY=VALUE]... [--force]
#                          replace the current world with a new one (kept in backups/)
#   pcds start | stop | restart | status | logs
#   pcds install-service | uninstall-service    start at login, check for game updates hourly
#   pcds code | players | save | kick PLAYER | ban PLAYER | unban NAME_OR_IP
#   pcds gui | token | config | api METHOD PATH [JSON]
#   pcds rules [set SECTION.RULE=VALUE ... | reset]
#                          show or change the server rules (rules.json; README "Server rules")
#   pcds extract [--game DIR]   extract the game tables again (needs Wine)
#   pcds update [--game DIR]    after a game update: extract and restart when the game changed
#   pcds selftest               a scripted player joins over direct IP and checks the answers
#   pcds run                    run the server in the foreground (debugging)
#   pcds container              the Docker image's start (tables, world, then run)
#   pcds build                  build the server (cargo) and the extractor (Docker, .NET SDK)
#
# Everything the server keeps lives in run/ next to this script (PCDS_HOME overrides it):
# worlds/ (one save per world, with their backups/), server.env, access.json, rules.json,
# data/<game version>/ and the extractor.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SRC="$ROOT/server"
RUN="${PCDS_HOME:-$ROOT/run}"
ENV_FILE="$RUN/server.env"
WORLDS="$RUN/worlds"
STEAMCMD="$RUN/steamcmd"
EXT="$RUN/extractor"
EXT_GAME="$EXT/game"
EXT_LOG="$EXT_GAME/BepInEx/LogOutput.log"
CACHE="$RUN/cache"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
# PCDS_HOME and PCDS_UNIT give a second server on the same machine its own folder and units.
UNIT_NAME="${PCDS_UNIT:-pcds}"
UNIT="$UNIT_NAME.service"
APP_ID=1284190
BEPINEX_VERSION=5.4.23.5
BEPINEX_SHA256=82f9878551030f54657792c0740d9d51a09500eeae1fba21106b0c441e6732c4
EXT_PORT=7791
EXT_API=7781

die() { echo "pcds: $*" >&2; exit 1; }
# In the container, a command run as root (docker exec) goes on as the owner of /data.
if [[ $EUID -eq 0 && -n "${PCDS_CONTAINER:-}" && "$(stat -c %u "$RUN" 2> /dev/null || echo 0)" != 0 ]]; then
  exec setpriv --reuid="$(stat -c %u "$RUN")" --regid="$(stat -c %g "$RUN")" --clear-groups "$0" "$@"
fi
[[ $EUID -ne 0 ]] || die "run pcds as the user the server runs as, not as root"
# --fail-with-body (curl 7.76+) shows the API's error message; older curl gets --fail.
CURL_FAIL=--fail
curl --help all 2> /dev/null | grep -q -- --fail-with-body && CURL_FAIL=--fail-with-body
say() { echo "pcds: $*"; }
need() { command -v "$1" > /dev/null || die "$1 is needed: $2"; }

env_get() {
  [[ -f "$ENV_FILE" ]] && sed -n "s/^$1=//p" "$ENV_FILE" | tail -1
  return 0
}
port() { local listen; listen="$(env_get PCDS_LISTEN)"; echo "${listen##*:}"; }
json_str() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }
# The unit is this installation's when it reads this settings file. In the container there is
# no systemd: the server is the container's own process.
active() {
  if [[ -n "${PCDS_CONTAINER:-}" ]]; then
    pgrep -u "$(id -u)" -x pcds-server > /dev/null
    return
  fi
  systemctl --user is-active --quiet "$UNIT" 2> /dev/null &&
    systemctl --user show -p EnvironmentFiles --value "$UNIT" 2> /dev/null | grep -qF "$ENV_FILE"
}

set_env() {
  if grep -q "^$1=" "$ENV_FILE"; then
    sed -i "s|^$1=.*|$1=$2|" "$ENV_FILE"
  else
    echo "$1=$2" >> "$ENV_FILE"
  fi
}

# ---- worlds --------------------------------------------------------------------------------

# The world the server runs: worlds/<PCDS_WORLD>.json.
world_name() {
  local name="${PCDS_WORLD:-$(env_get PCDS_WORLD)}"
  echo "${name:-world}"
}
world_file() { echo "$WORLDS/$(world_name).json"; }

# A world name from an argument (a file name works too).
world_arg() {
  local name="${1%.json}"
  name="${name##*/}"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "world names are letters, digits, '.', '_' and '-' (up to 64): '${1:-}'"
  echo "$name"
}

# Until 0.5 there was one world, run/world.json: it moves to worlds/world.json with its
# backups, while no server runs from it. "force": the server is the one starting; "stop": stop
# it first (setup and up, which start it again).
migrate_layout() {
  [[ -f "$RUN/world.json" ]] || return 0
  if [[ -e "$WORLDS/world.json" ]]; then
    say "both $RUN/world.json and $WORLDS/world.json exist: the server runs the second; move the first into $WORLDS under another name to keep it"
    return 0
  fi
  case "${1:-}" in
    force) ;;
    stop)
      if active; then
        say "stopping the server to move its world into $WORLDS"
        systemctl --user stop "$UNIT"
      fi
      ;;
    *) active && return 0 ;;
  esac
  mkdir -p "$WORLDS/backups"
  mv "$RUN/world.json" "$WORLDS/world.json"
  if [[ -d "$RUN/backups" ]]; then
    mv -n "$RUN/backups"/*.json "$WORLDS/backups/" 2> /dev/null || true
    rmdir "$RUN/backups" 2> /dev/null || true
  fi
  say "worlds now live in $WORLDS (world.json and its backups moved there)"
}

restart_if_running() {
  if [[ -n "${PCDS_CONTAINER:-}" ]]; then
    say "restart the container for it to take effect (docker restart CONTAINER)"
  elif active; then
    systemctl --user restart "$UNIT"
    say "server restarted"
  fi
}

# ---- the server binary ---------------------------------------------------------------------

# A release ships bin/; a source checkout builds server/.
server_bin() {
  if [[ -x "$ROOT/bin/pcds-server" ]]; then
    echo "$ROOT/bin/pcds-server"
    return
  fi
  [[ -x "$SRC/target/release/pcds-server" ]] || build_server >&2
  steam_lib "$SRC/target/release"
  echo "$SRC/target/release/pcds-server"
}

build_server() {
  need cargo "install Rust (https://rustup.rs), or use a release, which ships bin/pcds-server"
  (cd "$SRC" && cargo build --release)
  steam_lib "$SRC/target/release"
}

# The server finds the Steam API library next to itself; cargo leaves it in the steamworks
# crate's build output.
steam_lib() {
  [[ -f "$1/libsteam_api.so" ]] && return
  local lib
  lib="$(ls -t "$1"/build/steamworks-sys-*/out/libsteam_api.so 2> /dev/null | head -1)"
  [[ -n "$lib" ]] || die "no libsteam_api.so in $1/build (rebuild with 'pcds build')"
  cp "$lib" "$1/"
}

# Copy then rename, so a running server keeps its mapped copy.
install_file() { cp "$1" "$2.new" && mv -f "$2.new" "$2"; }

# The server runs from run/bin, so rebuilding never touches a running server.
install_server() {
  local bin
  bin="$(server_bin)"
  mkdir -p "$RUN/bin/web"
  install_file "$bin" "$RUN/bin/pcds-server"
  install_file "$(dirname "$bin")/libsteam_api.so" "$RUN/bin/libsteam_api.so"
  install_file "$( [[ -f "$ROOT/web/index.html" ]] && echo "$ROOT/web/index.html" || echo "$SRC/web/index.html")" "$RUN/bin/web/index.html"
}

# The extracted game tables: those of the installed game when known (a game rolled back to
# an older version keeps working), else the newest.
data_dir() {
  local d current=""
  [[ -f "$RUN/game-dir" ]] && current="$(buildid_of "$(cat "$RUN/game-dir")")"
  if [[ -n "$current" ]]; then
    for d in "$RUN"/data/*/; do
      if [[ "$(cat "$d/buildid" 2> /dev/null)" == "$current" && -f "$d/netdata.json" && -f "$d/gamedata.json" ]]; then
        echo "${d%/}"
        return 0
      fi
    done
  fi
  d="$(ls -d "$RUN"/data/*/ 2> /dev/null | sort -V | tail -1)"
  [[ -n "$d" && -f "$d/netdata.json" && -f "$d/gamedata.json" ]] && echo "${d%/}"
  return 0
}

# ---- settings and the admin API ------------------------------------------------------------

write_env() {
  [[ -f "$ENV_FILE" ]] && return
  mkdir -p "$RUN"
  # The admin token is in it: readable by this user only.
  (umask 077 && : > "$ENV_FILE")
  cat > "$ENV_FILE" << EOF
# Planet Crafter dedicated server settings. Apply with: pcds restart
# Direct IP (UDP): players join with HOST:PORT; "off" disables.
PCDS_LISTEN=0.0.0.0:${PCDS_PORT:-7777}
# Invite codes through Steam (an anonymous Steam game server; needs steamclient.so,
# see README); "off" disables.
PCDS_STEAM=on
# A game server login token (https://steamcommunity.com/dev/managegameservers, app $APP_ID)
# keeps the invite code the same across restarts; without one it changes at every start.
PCDS_STEAM_TOKEN=
# Last four digits of the invite code.
PCDS_SESSION=4242
# Minutes between saves (0: only on stop), and the save backups kept in worlds/backups/.
PCDS_AUTOSAVE=5
PCDS_BACKUPS=24
PCDS_BACKUP_MINUTES=60
# Admin API and web page (pcds gui); keep it on 127.0.0.1 or behind a proxy. "off" disables.
PCDS_ADMIN=${PCDS_ADMIN_BIND:-127.0.0.1:7782}
PCDS_ADMIN_TOKEN=$(head -c 18 /dev/urandom | base64 | tr -d '/+=')
# The world the server runs: worlds/<name>.json (pcds worlds, pcds world use NAME).
PCDS_WORLD=world
EOF
  say "settings written to $ENV_FILE"
}

api() {
  local method=$1 path=$2 body=${3:-}
  local token addr
  token="$(env_get PCDS_ADMIN_TOKEN)"
  addr="$(env_get PCDS_ADMIN)"
  [[ -n "$token" && -n "$addr" && "$addr" != off ]] || die "no admin API in $ENV_FILE (PCDS_ADMIN / PCDS_ADMIN_TOKEN)"
  [[ "$method" != GET && -z "$body" ]] && body='{}'
  curl -sS "$CURL_FAIL" -X "$method" -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    ${body:+--data "$body"} "http://$addr$path"
  echo
}

cmd_status() {
  if ! active; then
    echo "state=stopped"
    return 0
  fi
  echo "state=running pid=$(systemctl --user show -p MainPID --value "$UNIT")"
  api GET /api/status | python3 -c '
import json, sys
d = json.load(sys.stdin)
d.pop("units", None)
print(json.dumps(d, indent=2))' 2> /dev/null || echo "admin API not answering yet"
}

cmd_players() {
  api GET /api/status | python3 -c '
import json, sys
players = json.load(sys.stdin)["players"]
for p in players:
    steam = p["steamId"] + (" (verified)" if p["verified"] else "") if p["steamId"] else "-"
    print("{:>4}  {:<24} {:<16} {:<28} {}s".format(p["id"], p["name"] or "(joining)", p["ip"], steam, p["connectedSeconds"]))
print(f"{len(players)} online")'
}

cmd_code() {
  local code
  code="$(api GET /api/status | python3 -c 'import json,sys; print(json.load(sys.stdin).get("inviteCode") or "")')"
  [[ -n "$code" ]] || die "no invite code (server stopped, Steam off, or Steam not reachable; see pcds logs)"
  echo "$code"
}

# ---- the systemd units ---------------------------------------------------------------------

write_unit() {
  mkdir -p "$UNIT_DIR"
  cat > "$UNIT_DIR/$UNIT" << EOF
[Unit]
Description=Planet Crafter dedicated server
After=network-online.target
# A server that keeps crashing stops after 5 starts in 10 minutes.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Environment="PCDS_HOME=$RUN" "PCDS_UNIT=$UNIT_NAME"
EnvironmentFile=$ENV_FILE
ExecStart="$ROOT/pcds" run
Restart=on-failure
RestartSec=15
TimeoutStopSec=60

[Install]
WantedBy=default.target
EOF
  cat > "$UNIT_DIR/$UNIT_NAME-update.service" << EOF
[Unit]
Description=Planet Crafter dedicated server: pick up game updates

[Service]
Type=oneshot
Environment="PCDS_HOME=$RUN" "PCDS_UNIT=$UNIT_NAME"
ExecStart="$ROOT/pcds" update
EOF
  cat > "$UNIT_DIR/$UNIT_NAME-update.timer" << EOF
[Unit]
Description=Planet Crafter dedicated server: hourly game update check

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target
EOF
  systemctl --user daemon-reload
}

cmd_install_service() {
  [[ -f "$(world_file)" ]] || die "run 'pcds setup' first"
  write_unit
  systemctl --user enable --now "$UNIT" "$UNIT_NAME-update.timer"
  say "the server now starts at login and checks for game updates hourly"
  say "to keep it running while you are logged out: loginctl enable-linger $USER"
}

cmd_uninstall_service() {
  systemctl --user disable --now "$UNIT" "$UNIT_NAME-update.timer" 2> /dev/null || true
  rm -f "$UNIT_DIR/$UNIT" "$UNIT_DIR/$UNIT_NAME-update.service" "$UNIT_DIR/$UNIT_NAME-update.timer"
  systemctl --user daemon-reload
  say "removed the systemd units (run/ is kept)"
}

# Foreground run, as the unit does: the newest tables, the world, the settings.
cmd_run() {
  local data world
  migrate_layout force
  data="$(data_dir)"
  [[ -n "$data" ]] || die "no game tables in $RUN/data: run 'pcds extract' (see README)"
  world="$(world_file)"
  [[ -f "$world" ]] || die "no world at $world: 'pcds worlds', 'pcds world use NAME' or 'pcds world new NAME'"
  # After an upgrade (a new build or release), the newer binary.
  if [[ ! -x "$RUN/bin/pcds-server" || "$(server_bin)" -nt "$RUN/bin/pcds-server" ]]; then
    install_server
  fi
  if [[ -z "${PCDS_ADMIN_TOKEN:-}" && -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
  fi
  # Access lists and rules are the installation's, whichever world runs.
  export PCDS_ACCESS="${PCDS_ACCESS:-$RUN/access.json}" PCDS_RULES="${PCDS_RULES:-$RUN/rules.json}"
  exec "$RUN/bin/pcds-server" "$data" "$world"
}

# A new world at a path: made beside, then moved over, so a failed creation leaves what was
# there as it was.
new_world() {
  local path=$1 data
  shift
  data="$(data_dir)"
  [[ -n "$data" ]] || die "no game tables yet: run 'pcds extract' first"
  mkdir -p "$WORLDS" "$RUN/.new"
  "$(server_bin)" new "$RUN/.new/world.json" "$data" "$@"
  mv -f "$RUN/.new/world.json" "$path"
  rmdir "$RUN/.new"
}

# A world's file goes to worlds/backups/ before something replaces or removes it.
keep_copy() {
  mkdir -p "$WORLDS/backups"
  cp -p "$WORLDS/$1.json" "$WORLDS/backups/$1-$2-$(date -u +%Y%m%d-%H%M%S).json"
}

cmd_new() {
  local force=0 args=() world
  while (($#)); do
    case "$1" in
      --force) force=1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  migrate_layout
  world="$(world_file)"
  if [[ -f "$world" ]]; then
    ((force)) || die "a world exists at $world; pass --force to replace it (it is kept in backups/), or make another: pcds world new NAME"
    active && die "stop the server first (pcds stop)"
    keep_copy "$(world_name)" replaced
  fi
  new_world "$world" "${args[@]}"
}

cmd_worlds() {
  migrate_layout
  local current f n files=()
  current="$(world_name)"
  for f in "$WORLDS"/*.json; do
    [[ -f "$f" ]] && files+=("$f")
  done
  if ((${#files[@]} == 0)); then
    say "no worlds in $WORLDS yet: 'pcds world new NAME', 'pcds world import SAVE.json', or copy a save there"
    return 0
  fi
  for f in "${files[@]}"; do
    n="$(basename "$f" .json)"
    printf '%s %-28s %7s  %s\n' "$([[ "$n" == "$current" ]] && echo '*' || echo ' ')" "$n" "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%Y-%m-%d %H:%M')"
  done
  echo "(* the server runs it; add a world by copying a save into $WORLDS)"
}

cmd_world() {
  local sub=${1:-} name force=0 args=()
  (($#)) && shift
  migrate_layout
  case "$sub" in
    use)
      name="$(world_arg "${1:-}")"
      [[ -f "$WORLDS/$name.json" ]] || die "no world $name in $WORLDS ('pcds worlds' lists them)"
      write_env
      set_env PCDS_WORLD "$name"
      say "the server runs $name from now on"
      restart_if_running
      ;;
    new)
      name="$(world_arg "${1:-}")"
      shift
      while (($#)); do
        case "$1" in
          --force) force=1 ;;
          *) args+=("$1") ;;
        esac
        shift
      done
      if [[ -f "$WORLDS/$name.json" ]]; then
        ((force)) || die "world $name exists (--force replaces it; the old one is kept in backups/)"
        [[ "$name" == "$(world_name)" ]] && active && die "stop the server first: it runs $name"
        keep_copy "$name" replaced
      fi
      new_world "$WORLDS/$name.json" "${args[@]}"
      say "world $name created; 'pcds world use $name' plays it"
      ;;
    import)
      local save=${1:-}
      [[ -f "$save" ]] || die "pcds world import SAVE.json [NAME]: no save at '$save'"
      grep -q 'saveDisplayName' "$save" || die "$save is not a Planet Crafter save"
      name="$(world_arg "${2:-$save}")"
      [[ -f "$WORLDS/$name.json" ]] && die "world $name exists: pass another NAME"
      mkdir -p "$WORLDS"
      cp "$save" "$WORLDS/$name.json.part"
      mv "$WORLDS/$name.json.part" "$WORLDS/$name.json"
      say "world $name imported; 'pcds world use $name' plays it"
      ;;
    remove)
      name="$(world_arg "${1:-}")"
      [[ -f "$WORLDS/$name.json" ]] || die "no world $name in $WORLDS"
      [[ "$name" == "$(world_name)" ]] && die "the server runs $name: 'pcds world use' another one first"
      # Moved into backups/ rather than deleted.
      mkdir -p "$WORLDS/backups"
      mv "$WORLDS/$name.json" "$WORLDS/backups/$name-removed-$(date -u +%Y%m%d-%H%M%S).json"
      say "world $name removed (it is kept in $WORLDS/backups/)"
      ;;
    *) die "pcds world use NAME | new NAME [OPTIONS] | import SAVE.json [NAME] | remove NAME" ;;
  esac
}

# ---- extracting the game tables ------------------------------------------------------------

# Steam's build id for the install a game folder came from; for a copied folder (no Steam
# manifest), a hash of the game's code, which changes with every game update.
buildid_of() {
  local manifest
  manifest="$(dirname "$(dirname "$1")")/appmanifest_$APP_ID.acf"
  if [[ -f "$manifest" ]]; then
    sed -n 's/.*"buildid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$manifest"
  elif [[ -f "$1/Planet Crafter_Data/Managed/Assembly-CSharp.dll" ]]; then
    echo "sha-$(sha256sum "$1/Planet Crafter_Data/Managed/Assembly-CSharp.dll" | cut -c1-16)"
  fi
  return 0
}

# Steam's folders and every library listed in them (other drives too).
steam_libraries() {
  local root
  for root in "$HOME/.local/share/Steam" "$HOME/.steam/steam" "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"; do
    echo "$root"
    [[ -f "$root/steamapps/libraryfolders.vdf" ]] && sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$root/steamapps/libraryfolders.vdf"
  done
  return 0
}

# The game folder: --game, PCDS_GAME_DIR, the one used last, a steamcmd download, or a Steam
# library.
game_dir() {
  local d libraries=()
  mapfile -t libraries < <(steam_libraries)
  for d in "${1:-}" "${PCDS_GAME_DIR:-}" "$(cat "$RUN/game-dir" 2> /dev/null || true)" "$RUN/game" \
    "${libraries[@]/%//steamapps/common/The Planet Crafter}"; do
    if [[ -n "$d" && -f "$d/Planet Crafter.exe" && -d "$d/Planet Crafter_Data" ]]; then
      echo "$d"
      return
    fi
  done
  die "game not found: pass --game DIR (the folder with 'Planet Crafter.exe', e.g. copied from a PC) or set PCDS_GAME_DIR"
}

fetch_bepinex() {
  local zip="$CACHE/BepInEx_win_x64_$BEPINEX_VERSION.zip"
  if [[ ! -f "$zip" ]]; then
    mkdir -p "$CACHE"
    say "downloading BepInEx $BEPINEX_VERSION (the mod loader the extractor runs in)" >&2
    curl -fsSL -o "$zip.part" "https://github.com/BepInEx/BepInEx/releases/download/v$BEPINEX_VERSION/BepInEx_win_x64_$BEPINEX_VERSION.zip"
    mv "$zip.part" "$zip"
  fi
  echo "$BEPINEX_SHA256  $zip" | sha256sum -c --quiet - || { rm -f "$zip"; die "BepInEx download corrupt; run again"; }
  echo "$zip"
}

extractor_dll() {
  local d
  # A release's copy, a local build (pcds build), then the one committed with the source.
  for d in "$ROOT/bin/PcdsExtractor.dll" "$ROOT/extractor/bin/Release/net472/PcdsExtractor.dll" "$ROOT/extractor/prebuilt/PcdsExtractor.dll"; do
    if [[ -f "$d" ]]; then
      echo "$d"
      return
    fi
  done
  build_extractor >&2
  echo "$ROOT/extractor/bin/Release/net472/PcdsExtractor.dll"
}

# Needs the extractor game folder (BepInEx and the game's assemblies to compile against).
build_extractor() {
  need docker "to build the extractor (or use a release, which ships bin/PcdsExtractor.dll)"
  [[ -d "$EXT_GAME/BepInEx/core" ]] || die "no extractor game folder yet: run 'pcds extract' once"
  local game
  game="$(readlink -f "$EXT_GAME/Planet Crafter_Data")"
  mkdir -p "$CACHE/nuget"
  docker run --rm -v "$ROOT:/src" -v "$EXT_GAME:/game" -v "${game%/*}:${game%/*}:ro" -v "$CACHE/nuget:/root/.nuget/packages" \
    -w /src/extractor -e GameDir=/game mcr.microsoft.com/dotnet/sdk:8.0 \
    bash -c "dotnet build -c Release -nologo -v q && chown -R $(id -u):$(id -g) /src/extractor /root/.nuget/packages"
}

# A view of the game with BepInEx and the extractor installed: the program files are copied
# (Wine finds the game's folder from them), everything else is linked, so nothing is written
# into your game.
prepare_extractor() {
  local game=$1 entry zip
  zip="$(fetch_bepinex)"
  rm -rf "$EXT_GAME.new"
  mkdir -p "$EXT_GAME.new"
  # A leftover game from an interrupted extraction would hold the folder and the ports.
  ext_env
  wineserver -k 2> /dev/null || true
  for entry in "$game"/* "$game"/.doorstop_version; do
    [[ -e "$entry" ]] || continue
    case "${entry##*/}" in
      # The game's own mod loader, if it has one, stays out: the extractor brings its own, and
      # nothing is written through a link into the game folder.
      BepInEx | doorstop_config.ini | .doorstop_version | winhttp.dll | steam_appid.txt) ;;
      *.exe | *.dll) cp -p "$entry" "$EXT_GAME.new/" ;;
      *) ln -s "$entry" "$EXT_GAME.new/" ;;
    esac
  done
  (cd "$EXT_GAME.new" && unzip -qo "$zip")
  # The game then starts without asking for the Steam client.
  echo "$APP_ID" > "$EXT_GAME.new/steam_appid.txt"
  mkdir -p "$EXT_GAME.new/BepInEx/plugins" "$EXT_GAME.new/BepInEx/config"
  printf '[Extractor]\r\nSaveName = Extract-1\r\nPort = %s\r\nApiPort = %s\r\nApiToken = %s\r\n' \
    "$EXT_PORT" "$EXT_API" "$(head -c 18 /dev/urandom | base64 | tr -d '/+=')" > "$EXT_GAME.new/BepInEx/config/pcds.extractor.cfg"
  rm -rf "$EXT_GAME"
  mv "$EXT_GAME.new" "$EXT_GAME"
  cp -p "$(extractor_dll)" "$EXT_GAME/BepInEx/plugins/PcdsExtractor.dll"
}

ext_api() {
  local token
  token="$(sed -n 's/^ApiToken = //p' "$EXT_GAME/BepInEx/config/pcds.extractor.cfg" | tr -d '\r')"
  curl -sS "$CURL_FAIL" -X "$1" -H "Authorization: Bearer $token" ${3:+--data "$3"} "http://127.0.0.1:$EXT_API$2"
}

ext_env() {
  export WINEPREFIX="$EXT/prefix" WINEDEBUG=-all WINEDLLOVERRIDES="winhttp=n,b"
}

start_extractor() {
  need wine "to run the game once for the extraction (e.g. 'apt install wine', 'dnf install wine', 'pacman -S wine')"
  ext_env
  if [[ ! -d "$WINEPREFIX/drive_c" ]]; then
    say "creating the Wine prefix (first run only)"
    wineboot -i > /dev/null 2>&1 || true
  fi
  # No sound device: the game would otherwise play its music on this machine.
  wine reg add 'HKCU\Software\Wine\Drivers' /v Audio /d '' /f > /dev/null 2>&1 || true
  # Those started Wine's session without a display: the game would join it and could not make
  # its window under Xvfb. It starts its own.
  wineserver -k 2> /dev/null || true
  wineserver -w 2> /dev/null || true
  local runner=()
  if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    command -v xvfb-run > /dev/null || die "no display: install Xvfb (xvfb-run; package xvfb or xorg-x11-server-Xvfb) for the extraction"
    # A 24-bit screen: Unity cannot make its window on xvfb-run's default 8-bit one.
    runner=(xvfb-run -a -s "-screen 0 1280x720x24")
  fi
  rm -f "$EXT_LOG"
  (cd "$EXT_GAME" && setsid "${runner[@]}" wine "Planet Crafter.exe" -batchmode -nographics -logFile "Z:${EXT//\//\\}\\player.log" > "$EXT/wine.log" 2>&1 < /dev/null &)
  local _
  for _ in $(seq 600); do
    grep -qs "PCDS READY" "$EXT_LOG" && return 0
    sleep 1
  done
  stop_extractor
  die "the game did not start; see $EXT_LOG and $EXT/wine.log"
}

stop_extractor() {
  ext_env
  ext_api POST /api/stop '{}' > /dev/null 2>&1 || true
  local _
  for _ in $(seq 30); do
    grep -qs "PCDS STOPPED" "$EXT_LOG" && break
    sleep 1
  done
  sleep 2
  wineserver -k 2> /dev/null || true
}

# PlanetData's stable hash of a planet id (the game's String.GetStableHashCode).
planet_hash() {
  python3 -c '
import sys
def h(s):
    i32 = lambda x: ((x + 2**31) % 2**32) - 2**31
    u = [ord(c) for c in s]; h1 = h2 = 5381; i = 0
    while i < len(u):
        h1 = i32((i32(h1 << 5) + h1) ^ u[i])
        if i == len(u) - 1: break
        h2 = i32((i32(h2 << 5) + h2) ^ u[i + 1]); i += 2
    return i32(h1 + i32(h2 * 1566083941))
print(h(sys.argv[1]))' "$1"
}

# Runs the game once with the extractor and writes run/data/<game version>/.
cmd_extract() {
  local game_arg=""
  while (($#)); do
    case "$1" in
      --game) game_arg="${2:?--game DIR}"; shift ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  local game bin version out raw probe planets planet current
  game="$(game_dir "$game_arg")"
  bin="$(server_bin)"
  mkdir -p "$RUN"
  echo "$game" > "$RUN/game-dir"
  say "extracting the game tables from $game"
  prepare_extractor "$game"
  # One extraction at a time (the hourly update and a manual one would share the game).
  exec 9> "$RUN/.extract.lock"
  flock -n 9 || die "another extraction is running"
  trap stop_extractor EXIT
  start_extractor
  version="$(ext_api GET /api/status | python3 -c 'import json,sys; print(json.load(sys.stdin)["gameVersion"])')"
  # Hidden until complete: data_dir only picks finished versions.
  out="$RUN/data/.$version.new"
  rm -rf "$out"
  mkdir -p "$out/scenes"
  raw="$(mktemp)"
  probe="$(mktemp)"
  ext_api GET /api/netdata > "$raw"
  "$bin" extract "$raw" "$out" > /dev/null
  # Again with a scripted player joined (with the tables just written), for the layout a
  # joining player gets.
  printf '{"name":"Extractor","ready":false,"steps":[{"wait":90000}]}' > "$probe"
  timeout 120 "$bin" probe "127.0.0.1:$EXT_PORT" "$out" "$probe" > "$EXT/probe.log" 2>&1 &
  local joiner=$! joined=0
  for _ in $(seq 40); do
    sleep 2
    ext_api GET /api/netdata > "$raw"
    if python3 -c 'import json,sys; sys.exit(0 if any(o.get("player") and o.get("owner") for o in json.load(open(sys.argv[1]))["objects"]) else 1)' "$raw"; then
      joined=1
      break
    fi
  done
  kill "$joiner" 2> /dev/null || true
  wait "$joiner" 2> /dev/null || true
  ((joined)) || die "the scripted player did not join the game; see $EXT/probe.log"
  "$bin" extract "$raw" "$out"
  ext_api GET /api/gamedata > "$out/gamedata.json"
  ext_api GET /api/wreckdata > "$out/wrecks.json"
  planets="$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(" ".join(v["id"] for k,v in d["assets"].items() if k.startswith("PlanetData:") and v.get("steamAppId")==0 and v.get("showInBuild")))' "$out/gamedata.json")"
  for planet in $planets; do
    current="$(ext_api GET /api/status | python3 -c 'import json,sys; print(json.load(sys.stdin)["planet"])')"
    if [[ "$current" != "$planet" ]]; then
      say "travelling to $planet"
      printf '{"name":"Traveller","steps":[{"rpc":"PlanetNetworkLoader.SwitchToPlanetServerRpc","on":"PlanetNetworkLoader","args":[%s,0,0],"after":2000},{"wait":5000}]}' "$(planet_hash "$planet")" > "$probe"
      # The game refuses players for a while after the game data dump (it is still removing
      # what it spawned), so travel is retried until the planet changes.
      for _ in $(seq 5); do
        timeout 60 "$bin" probe "127.0.0.1:$EXT_PORT" "$out" "$probe" > /dev/null 2>&1 || true
        for _ in $(seq 12); do
          sleep 5
          current="$(ext_api GET /api/status 2> /dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["planet"])' 2> /dev/null || true)"
          [[ "$current" == "$planet" ]] && break 2
        done
      done
      [[ "$current" == "$planet" ]] || die "the game did not reach $planet"
      sleep 15
    fi
    ext_api GET /api/scenedata > "$out/scenes/$planet.json"
  done
  rm -f "$raw" "$probe"
  stop_extractor
  trap - EXIT
  buildid_of "$game" > "$out/buildid"
  rm -rf "$RUN/data/$version"
  mv "$out" "$RUN/data/$version"
  say "game tables for $version in $RUN/data/$version (planets: $planets)"
}

cmd_update() {
  local game_arg="" game installed current data
  while (($#)); do
    case "$1" in
      --game) game_arg="${2:?--game DIR}"; shift ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  update_downloaded_game
  game="$(game_dir "$game_arg")"
  data="$(data_dir)"
  current="$(buildid_of "$game")"
  installed="$( [[ -n "$data" ]] && cat "$data/buildid" 2> /dev/null || true)"
  if [[ -n "$data" && -n "$current" && "$current" == "$installed" ]]; then
    say "up to date (game build $current)"
    return 0
  fi
  say "game build ${installed:-unknown} -> ${current:-unknown}"
  cmd_extract --game "$game"
  if active; then
    systemctl --user restart "$UNIT"
    say "server restarted on the new tables"
  fi
}

# ---- setup and checks ----------------------------------------------------------------------

have_steamclient() {
  local f
  for f in "$HOME/.steam/sdk64/steamclient.so" "$HOME/.local/share/Steam/linux64/steamclient.so" "$HOME/.steam/steam/linux64/steamclient.so"; do
    [[ -f "$f" ]] && return 0
  done
  return 1
}

# Valve's command-line Steam client, in run/steamcmd.
fetch_steamcmd() {
  [[ -x "$STEAMCMD/steamcmd.sh" ]] && return 0
  say "downloading steamcmd (Valve's command-line Steam client)"
  mkdir -p "$STEAMCMD"
  curl -fsSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz | tar -xz -C "$STEAMCMD"
}

# Invite codes need Valve's steamclient.so: from Steam if it is installed, else from steamcmd.
ensure_steamclient() {
  [[ "$(env_get PCDS_STEAM)" == off ]] && return 0
  have_steamclient && return 0
  say "getting steamclient.so for invite codes (steamcmd's first run updates itself; a minute or two)"
  { fetch_steamcmd && "$STEAMCMD/steamcmd.sh" +quit > "$STEAMCMD/first-run.log" 2>&1; } || true
  if [[ -f "$STEAMCMD/linux64/steamclient.so" && ! -f "$HOME/.steam/sdk64/steamclient.so" ]]; then
    mkdir -p "$HOME/.steam/sdk64"
    ln -sf "$STEAMCMD/linux64/steamclient.so" "$HOME/.steam/sdk64/steamclient.so"
  fi
  have_steamclient || echo "pcds: no steamclient.so: steamcmd did not run (see $STEAMCMD/first-run.log; it needs" \
    "32-bit libraries such as lib32gcc-s1). Direct IP works; invite codes come once steamcmd runs" >&2
}

# The game (Windows build) with the owner's Steam account; steamcmd asks for the password and
# the Steam Guard code once and remembers the login for updates.
download_game() {
  fetch_steamcmd
  say "downloading The Planet Crafter as Steam user $1 (steamcmd asks for your password and Steam Guard code)"
  "$STEAMCMD/steamcmd.sh" +@sSteamCmdForcePlatformType windows +force_install_dir "$RUN/game" +login "$1" +app_update "$APP_ID" validate +quit
  [[ -f "$RUN/game/Planet Crafter.exe" ]] || die "the game download did not finish (see above)"
  echo "$1" > "$RUN/steam-user"
  echo "$RUN/game" > "$RUN/game-dir"
}

# A downloaded game follows updates with the remembered login (no prompt; skipped when Steam
# wants the password again).
update_downloaded_game() {
  [[ -f "$RUN/steam-user" && -x "$STEAMCMD/steamcmd.sh" ]] || return 0
  "$STEAMCMD/steamcmd.sh" +@sSteamCmdForcePlatformType windows +@NoPromptForPassword 1 +force_install_dir "$RUN/game" \
    +login "$(cat "$RUN/steam-user")" +app_update "$APP_ID" +quit < /dev/null > "$STEAMCMD/update.log" 2>&1 ||
    say "the game update through steamcmd did not run (see $STEAMCMD/update.log)"
}

cmd_setup() {
  local game_arg="" world="" new=0 new_args=() steam_user=""
  while (($#)); do
    case "$1" in
      --game) game_arg="${2:?--game DIR}"; shift ;;
      --world) world="${2:?--world SAVE.json}"; shift ;;
      --steam-user) steam_user="${2:?--steam-user NAME}"; shift ;;
      --new) new=1 ;;
      *) ((new)) && new_args+=("$1") || die "unknown option $1" ;;
    esac
    shift
  done
  local tool current
  for tool in curl python3 unzip sha256sum tar; do
    need "$tool" "install it with your package manager"
  done
  [[ -n "${PCDS_CONTAINER:-}" ]] || need systemctl "pcds runs the server as a systemd user service (or use the Docker image)"
  mkdir -p "$RUN"
  migrate_layout stop
  write_env
  install_server
  if [[ -n "$steam_user" ]]; then
    download_game "$steam_user"
    game_arg="$RUN/game"
  fi
  if [[ -z "$(data_dir)" ]]; then
    cmd_extract ${game_arg:+--game "$game_arg"}
  fi
  current="$(world_file)"
  if [[ -n "$world" ]]; then
    [[ -f "$world" ]] || die "no save at $world"
    grep -q 'saveDisplayName' "$world" || die "$world is not a Planet Crafter save"
    active && die "stop the server first (pcds stop): it would save over the imported world"
    [[ -f "$current" ]] && keep_copy "$(world_name)" replaced
    mkdir -p "$WORLDS"
    cp "$world" "$current"
    say "world $(world_name) copied from $world"
  elif ((new)); then
    if [[ -f "$current" ]]; then
      say "keeping the world $(world_name) ('pcds world new NAME' makes another)"
    else
      new_world "$current" "${new_args[@]}"
    fi
  elif [[ ! -f "$current" ]]; then
    die "no world yet: pass --world SAVE.json (a save from your game) or --new"
  fi
  [[ -n "${PCDS_CONTAINER:-}" ]] || write_unit
  ensure_steamclient
  say "ready: 'pcds start' runs it now, 'pcds install-service' starts it at login"
}

# The game's own saves on this machine (Proton), newest first.
local_saves() {
  local lib d
  while read -r lib; do
    d="$lib/steamapps/compatdata/$APP_ID/pfx/drive_c/users/steamuser/AppData/LocalLow/MijuGames/Planet Crafter"
    [[ -d "$d" ]] && grep -l 'saveDisplayName' "$d"/*.json 2> /dev/null
  done < <(steam_libraries) | xargs -r -d '\n' ls -t 2> /dev/null | head -9
  return 0
}

# On a terminal with saves of the game around: which one becomes the world (or a new one).
pick_save() {
  [[ -t 0 ]] || return 0
  local saves=() i choice
  mapfile -t saves < <(local_saves)
  ((${#saves[@]})) || return 0
  echo "Your saves of The Planet Crafter on this machine:" >&2
  for i in "${!saves[@]}"; do
    echo "  $((i + 1))) $(basename "${saves[$i]}" .json)  ($(date -r "${saves[$i]}" '+%Y-%m-%d %H:%M'))" >&2
  done
  read -r -p "Play one of them on the server (1-${#saves[@]}), or Enter for a new world: " choice
  if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#saves[@]})); then
    echo "${saves[$((choice - 1))]}"
  fi
  return 0
}

# How players get in, once the server answers.
summary() {
  local code="" ip _
  for _ in $(seq 30); do
    code="$(api GET /api/status 2> /dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("inviteCode") or "")' 2> /dev/null || true)"
    [[ -n "$code" || "$(env_get PCDS_STEAM)" == off ]] && break
    sleep 2
  done
  ip="$(ip -4 route get 1.1.1.1 2> /dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')"
  if [[ -n "$code" ]]; then
    code="$code   (it changes at every start unless PCDS_STEAM_TOKEN is set)"
  else
    code="none yet (see ./pcds logs; ./pcds code prints it)"
  fi
  echo
  echo "  The server is running the world \"$(world_name)\"."
  echo "    Invite code: $code"
  echo "    Direct IP:   ${ip:-this machine}:$(port) (UDP; forward it on your router for players outside your network)"
  echo "    Admin page:  http://$(env_get PCDS_ADMIN)/#token=$(env_get PCDS_ADMIN_TOKEN)"
  echo "    Manage it:   cd $ROOT && ./pcds status | players | worlds | rules | logs"
  echo
}

# From nothing to a running server: setup (game tables, a world, settings), the service, a
# check that players get in, and how to join.
cmd_up() {
  local args=("$@") world_given=0 save a _
  for a in "$@"; do
    [[ "$a" == --world || "$a" == --new ]] && world_given=1
  done
  migrate_layout stop
  if ((!world_given)) && [[ ! -f "$(world_file)" ]]; then
    save="$(pick_save)"
    if [[ -n "$save" ]]; then
      args+=(--world "$save")
    else
      args+=(--new)
    fi
  fi
  cmd_setup "${args[@]}"
  if [[ -n "${PCDS_CONTAINER:-}" ]] || ! systemctl --user show-environment > /dev/null 2>&1; then
    say "no systemd user session here: start the server with './pcds run'"
    return 0
  fi
  systemctl --user enable "$UNIT" "$UNIT_NAME-update.timer" 2> /dev/null
  systemctl --user restart "$UNIT"
  systemctl --user start "$UNIT_NAME-update.timer"
  if loginctl enable-linger "$USER" 2> /dev/null; then
    say "the server starts with the machine and keeps running while you are logged out"
  else
    say "to keep it running while you are logged out: sudo loginctl enable-linger $USER"
  fi
  for _ in $(seq 60); do
    api GET /api/status > /dev/null 2>&1 && break
    sleep 1
  done
  cmd_selftest
  summary
}

# The Docker image's start: the game tables (from the game mounted at /game, or downloaded
# with STEAM_USER), a world, steamclient for invite codes, then the server as this process.
cmd_container() {
  local game data current installed newest
  mkdir -p "$RUN" "$WORLDS"
  migrate_layout force
  write_env
  install_server
  if [[ -n "${STEAM_USER:-}" && ! -f "$RUN/game/Planet Crafter.exe" ]]; then
    [[ -t 0 ]] || die "STEAM_USER: the first download needs a terminal for the Steam login (docker run -it ...)"
    download_game "$STEAM_USER"
  fi
  update_downloaded_game
  game="$(game_dir 2> /dev/null)" || game=""
  if [[ -n "$game" ]]; then
    data="$(data_dir)"
    current="$(buildid_of "$game")"
    installed="$( [[ -n "$data" ]] && cat "$data/buildid" 2> /dev/null || true)"
    # The first start, or a game update: this game build's tables.
    [[ -n "$data" && "$current" == "$installed" ]] || cmd_extract --game "$game"
  fi
  [[ -n "$(data_dir)" ]] || die "no game tables: mount your game folder at /game (-v '/path/to/The Planet Crafter:/game:ro'), or start once with 'docker run -it -e STEAM_USER=yourname ...' to download the game"
  if [[ ! -f "$(world_file)" ]]; then
    newest="$(ls -t "$WORLDS"/*.json 2> /dev/null | head -1 || true)"
    if [[ -n "$newest" && -z "${PCDS_WORLD:-}" ]]; then
      set_env PCDS_WORLD "$(basename "$newest" .json)"
      say "running the world $(world_name) (the newest in $WORLDS)"
    else
      say "no world yet: making a new one, $(world_name)"
      # shellcheck disable=SC2086
      new_world "$(world_file)" ${PCDS_NEW_WORLD:-}
    fi
  fi
  ensure_steamclient
  say "manage it with: docker exec CONTAINER pcds worlds | players | rules | gui"
  cmd_run
}

# The rules through the admin API: shown, set as SECTION.RULE=VALUE (values are JSON, else
# text; null resets one), or all reset to the game's behaviour.
cmd_rules() {
  case "${1:-}" in
    "") api GET /api/rules | python3 -m json.tool ;;
    set)
      shift
      (($#)) || die "pcds rules set SECTION.RULE=VALUE ... ('pcds rules' lists them)"
      api POST /api/rules "$(python3 -c '
import json, sys
patch = {}
for arg in sys.argv[1:]:
    key, sep, value = arg.partition("=")
    if not sep or "." not in key:
        sys.exit("pcds: " + arg + ": expected SECTION.RULE=VALUE")
    try:
        value = json.loads(value)
    except ValueError:
        pass
    *path, last = key.split(".")
    node = patch
    for p in path:
        node = node.setdefault(p, {})
    node[last] = value
print(json.dumps(patch))' "$@")" | python3 -m json.tool
      ;;
    reset)
      api POST /api/rules "$(api GET /api/rules | python3 -c 'import json, sys; print(json.dumps({k: None for k in json.load(sys.stdin)["defaults"]}))')" | python3 -m json.tool
      ;;
    *) die "pcds rules [set SECTION.RULE=VALUE ... | reset]" ;;
  esac
}

cmd_selftest() {
  active || die "start the server first (pcds start)"
  local data script out
  data="$(data_dir)"
  script="$(mktemp)"
  # Joins and receives the world without becoming a player (nothing is saved for it).
  printf '{"name":"PcdsSelftest","ready":false,"steps":[{"wait":2000}]}' > "$script"
  local listen host
  listen="$(env_get PCDS_LISTEN)"
  host="${listen%:*}"
  [[ "$host" == 0.0.0.0 || "$host" == "[::]" || -z "$host" ]] && host=127.0.0.1
  [[ "$listen" == off ]] && die "direct IP is off (PCDS_LISTEN=off): nothing to test"
  out="$(timeout 60 "$(server_bin)" probe "$host:$(port)" "$data" "$script" 2>&1 || true)"
  rm -f "$script"
  if grep -q '"approved"' <<< "$out" && grep -q '"joined"' <<< "$out"; then
    say "selftest PASS: a connection over direct IP on $host:$(port) was approved and got the world"
  else
    echo "$out" | tail -5 >&2
    die "selftest FAIL (see above and pcds logs)"
  fi
}

in_container() { [[ -z "${PCDS_CONTAINER:-}" ]] || die "in the container: use 'docker $1 CONTAINER' instead"; }

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  setup) shift; cmd_setup "$@" ;;
  new) shift; cmd_new "$@" ;;
  worlds) cmd_worlds ;;
  world) shift; cmd_world "$@" ;;
  start | stop | restart)
    in_container "$1"
    [[ -f "$UNIT_DIR/$UNIT" ]] || die "run 'pcds setup' first"
    systemctl --user "$1" "$UNIT"
    ;;
  status) cmd_status ;;
  logs)
    in_container logs
    journalctl --user -o cat -u "$UNIT" -n 100 -f
    ;;
  install-service) cmd_install_service ;;
  uninstall-service) cmd_uninstall_service ;;
  code) cmd_code ;;
  players) cmd_players ;;
  save) api POST /api/save ;;
  kick) api POST /api/kick "{\"player\": $(json_str "${2:?player}")}" ;;
  ban) api POST /api/ban "{\"player\": $(json_str "${2:?player}")}" ;;
  unban) api POST /api/unban "{\"value\": $(json_str "${2:?name or ip}")}" ;;
  gui) echo "http://$(env_get PCDS_ADMIN)/#token=$(env_get PCDS_ADMIN_TOKEN)" ;;
  token) env_get PCDS_ADMIN_TOKEN ;;
  config) "${EDITOR:-nano}" "$ENV_FILE" ;;
  api) api "${2:?method}" "${3:?path}" "${4:-}" ;;
  rules) shift; cmd_rules "$@" ;;
  extract) shift; cmd_extract "$@" ;;
  update) shift; cmd_update "$@" ;;
  selftest) cmd_selftest ;;
  run) cmd_run ;;
  container) cmd_container ;;
  build)
    build_server
    install_server
    build_extractor
    ;;
  *)
    sed -n '2,/^set /p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
