# The same as the Makefile, for `just`.
build:
    cargo build --target wasm32-unknown-unknown --release
    cp {{env_var_or_default("CARGO_TARGET_DIR", "target")}}/wasm32-unknown-unknown/release/{crate}.wasm plugin.wasm

test:
    cargo test

check: build
    pcds plugin check .

scenario: build
    pcds plugin test .

package: build
    pcds plugin pack .

install: build
    pcds plugin install . --force
