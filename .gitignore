# Everything a server keeps (world, settings, backups, the game tables, downloads).
/run/
# Build output.
/server/target/
# Game tables are extracted from each user's own copy of the game, never committed.
/server/data/
# Release packaging.
/dist/
__pycache__/
# Coverage reports and other rebuildable output.
/out/
# The plugin API crate and the example plugins build into their own folders when built by hand.
/plugin-api/target/
/plugin-api/Cargo.lock
/examples/plugins/*/target/
