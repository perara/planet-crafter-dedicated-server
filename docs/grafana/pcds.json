    {
      "id": 11,
      "type": "timeseries",
      "title": "Game loop busy",
      "description": "Share of the last second the loop worked. Near 1 means the world cannot keep up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
