#!/usr/bin/env bash
# The text of a release, from CHANGELOG.md (docs/hot-update.md, "Release checklist").
#
#   scripts/release-notes vX.Y.Z [CHANGELOG.md]   print the section of that tag, without its heading
#   scripts/release-notes --check [CHANGELOG.md]  every section is well formed (CI runs this)
#
# A section is `## [X.Y.Z] - YYYY-MM-DD` up to the next `## `. It fails when there is none, when it
# has no date, or when it lacks the parts every release has: `### Breaking changes` and
# `### Upgrade`. The release workflow runs it on the tag before anything is built, so a tag
# without release notes never becomes a release.
set -euo pipefail

arg="${1:?usage: scripts/release-notes vX.Y.Z|--check [CHANGELOG.md]}"
file="${2:-$(dirname "$0")/../CHANGELOG.md}"
[[ -f "$file" ]] || { echo "release-notes: no $file" >&2; exit 1; }

# The body of version $1: its lines between its heading and the next one, link references left out.
section() {
  awk -v head="## [$1] - " '
    /^## / { if (on) exit; on = index($0, head) == 1; found = found || on; next }
    on && !/^\[[^]]+\]: / { print }
    END { exit !found }
  ' "$file"
}

# Fails (naming why) unless version $1 has a dated section with both parts.
well_formed() {
  local body
  body="$(section "$1")" || { echo "release-notes: $file has no section '## [$1] - YYYY-MM-DD'" >&2; return 1; }
  grep -qE '^## \['"${1//./\\.}"'\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$' "$file" || { echo "release-notes: the heading of [$1] needs the date: '## [$1] - YYYY-MM-DD'" >&2; return 1; }
  for part in "Breaking changes" "Upgrade"; do
    grep -q "^### $part\$" <<< "$body" || { echo "release-notes: [$1] has no '### $part' part" >&2; return 1; }
  done
}

if [[ "$arg" == --check ]]; then
  versions="$(sed -n 's/^## \[\([0-9][^]]*\)\].*/\1/p' "$file")"
  [[ -n "$versions" ]] || { echo "release-notes: $file has no release section" >&2; exit 1; }
  bad=0
  while read -r v; do well_formed "$v" || bad=1; done <<< "$versions"
  exit "$bad"
fi

[[ "$arg" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || { echo "release-notes: '$arg' is not a tag like v1.2.3" >&2; exit 1; }
version="${arg#v}"
well_formed "$version"
# Without the blank lines around it.
section "$version" | sed -e '/./,$!d' | tac | sed -e '/./,$!d' | tac
