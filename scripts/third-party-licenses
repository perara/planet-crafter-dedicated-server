#!/usr/bin/env python3
"""THIRD_PARTY_LICENSES: the licence of every crate in the pcds program, and Valve's terms.

  scripts/third-party-licenses           write THIRD_PARTY_LICENSES (needs the crates downloaded:
                                         after cargo build, or cargo fetch --locked)
  scripts/third-party-licenses --check   fail when the file is not what the lock file gives (CI)

The crates are the ones the program links on Linux x86-64 (normal dependencies of server/, from
`cargo metadata --locked`). Each crate's own licence and notice files are copied as they are, under
the crates that share the same text.
"""
import hashlib, json, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "THIRD_PARTY_LICENSES")
LICENSE_FILE = re.compile(r"^(LICEN[CS]E|COPYING|NOTICE|UNLICENSE)([-_. ].*)?$", re.I)

HEADER = """\
Third-party licences of the Planet Crafter dedicated server (pcds)
===================================================================

pcds itself is GPL-3.0-or-later (LICENSE), with the additional permission in README.md to link the
Steamworks SDK. This file lists what else is in the program you run and where its terms are.
It is generated by scripts/third-party-licenses from server/Cargo.lock; do not edit it.

1. Valve's Steamworks redistributable: libsteam_api.so
------------------------------------------------------

libsteam_api.so, next to the pcds program in a release and in /opt/pcds in the Docker image, is
Valve's Steamworks API library, taken unchanged from the redistributable files of the Steamworks
SDK that the `steamworks-sys` crate carries. It is not covered by the GPL and not by the licences
below. Valve's terms for it are the Steamworks SDK Access Agreement
(https://partner.steamgames.com/documentation/sdk_access_agreement) and the licence in the SDK.
Steam and the Steamworks SDK belong to Valve. The Planet Crafter belongs to Miju Games, which is
not involved in this project. Nothing of the game is in this program or its releases.

2. The Rust crates in the program
---------------------------------

The crates below are compiled into pcds. pcds-plugin-api (plugin-api/ in the repository) is
MIT OR Apache-2.0 (plugin-api/LICENSE-MIT, plugin-api/LICENSE-APACHE) and is listed with its
own files. Each group is the crates whose licence files are exactly the text that follows it.
"""


def metadata():
    out = subprocess.run(
        ["cargo", "metadata", "--locked", "--format-version", "1", "--filter-platform", "x86_64-unknown-linux-gnu",
         "--manifest-path", os.path.join(ROOT, "server", "Cargo.toml")],
        check=True, capture_output=True, text=True).stdout
    return json.loads(out)


def linked(meta):
    """Ids of the packages the program links: normal dependencies, reachable from the server."""
    nodes = {n["id"]: n for n in meta["resolve"]["nodes"]}
    root = meta["resolve"]["root"]
    seen, todo = set(), [root]
    while todo:
        i = todo.pop()
        if i in seen:
            continue
        seen.add(i)
        for d in nodes[i]["deps"]:
            if any(k["kind"] is None for k in d["dep_kinds"]):
                todo.append(d["pkg"])
    return seen


def license_files(directory):
    names = sorted(n for n in os.listdir(directory) if LICENSE_FILE.match(n) and os.path.isfile(os.path.join(directory, n)))
    return [(n, open(os.path.join(directory, n), encoding="utf-8", errors="replace").read().strip("\n")) for n in names]


def build():
    meta = metadata()
    ids = linked(meta) - {meta["resolve"]["root"]}
    packages = sorted((p for p in meta["packages"] if p["id"] in ids), key=lambda p: (p["name"], p["version"]))
    groups, missing = {}, []
    for p in packages:
        directory = os.path.dirname(p["manifest_path"])
        files = license_files(directory)
        label = f'{p["name"]} {p["version"]} ({p["license"] or "no licence field"})'
        if not files:
            missing.append(label + (f' by {", ".join(p["authors"])}' if p["authors"] else ""))
            continue
        text = "\n\n".join(f"--- {n} ---\n{t}" for n, t in files)
        groups.setdefault(hashlib.sha256(text.encode()).hexdigest(), (text, []))[1].append(label)
    parts = [HEADER]
    for text, labels in sorted(groups.values(), key=lambda g: g[1][0]):
        parts.append("=" * 79 + "\n" + "\n".join(labels) + "\n" + "=" * 79 + "\n\n" + text + "\n")
    if missing:
        parts.append("=" * 79 + "\nCrates that ship no licence file; their Cargo.toml names the licence\n(MIT and Apache-2.0: the standard texts above)\n" + "=" * 79 + "\n\n" + "\n".join(missing) + "\n")
    return "\n".join(parts), missing


def main():
    text, missing = build()
    if missing:
        print("third-party-licenses: no licence file in the crate: " + ", ".join(missing), file=sys.stderr)
    if sys.argv[1:] == ["--check"]:
        current = open(OUT, encoding="utf-8").read() if os.path.exists(OUT) else ""
        if current != text:
            sys.exit("third-party-licenses: THIRD_PARTY_LICENSES is out of date: run scripts/third-party-licenses")
        return
    open(OUT, "w", encoding="utf-8").write(text)
    print(f"third-party-licenses: wrote {OUT} ({len(text)} bytes)")


main()
